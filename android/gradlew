#!/bin/sh
set -e

APP_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
DEFAULT_JAVA_HOME="/Applications/Android Studio.app/Contents/jbr/Contents/Home"
DEFAULT_GRADLE_USER_HOME="/private/tmp/cineparte-android-gradle"

if [ -z "${JAVA_HOME:-}" ] && [ -x "$DEFAULT_JAVA_HOME/bin/java" ]; then
  JAVA_HOME="$DEFAULT_JAVA_HOME"
fi

if [ -z "${GRADLE_USER_HOME:-}" ]; then
  GRADLE_USER_HOME="$DEFAULT_GRADLE_USER_HOME"
fi

mkdir -p "$GRADLE_USER_HOME"
export GRADLE_USER_HOME

if [ -n "${JAVA_HOME:-}" ]; then
  JAVA_CMD="$JAVA_HOME/bin/java"
else
  JAVA_CMD="java"
fi

CLASSPATH="$APP_DIR/gradle/wrapper/gradle-wrapper.jar"

exec "$JAVA_CMD" -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
